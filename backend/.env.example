DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public address of the site, used for "open in inbox" links in alerts
SITE_URL=http://localhost:5173

# Digital twin — any OpenAI-compatible API
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
CHAT_RATE_LIMIT=30/hour

# RAG: the twin searches your profile + blog posts (ChromaDB index in backend/chroma/,
# rebuilt automatically when the app starts and whenever you save a post)
RAG_ENABLED=True
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5

# When a visitor asks to talk to you, the twin saves their details and alerts you.
# Fill in either or both channels.

# 1) Push notification to your phone — https://pushover.net
PUSHOVER_USER=
PUSHOVER_TOKEN=

# 2) Email — for Gmail create an App Password (Google Account → Security → App passwords)
NOTIFY_EMAIL_TO=matsilele.aubrey@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=matsilele.aubrey@gmail.com
EMAIL_HOST_PASSWORD=
